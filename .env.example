# Canonical site URL. Every absolute URL (canonical, sitemap, robots, Open Graph, JSON-LD) comes from this.
NEXT_PUBLIC_SITE_URL=https://www.ezygoatempotravels.com

# Google Tag Manager container ID. GA4 and Google Ads tags live inside GTM, never in the code.
NEXT_PUBLIC_GTM_ID=

# Optional. Leave empty when Search Console is verified by DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
